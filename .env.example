# LLM Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-3.5-turbo

# Alternative configurations:
# For local Ollama: LLM_BASE_URL=http://localhost:11434/v1
# For Anthropic: LLM_BASE_URL=https://api.anthropic.com/v1
# For local LM Studio: LLM_BASE_URL=http://localhost:1234/v1

# Game Configuration
GAME_DEBUG=false
SAVE_TO_CLOUD=false